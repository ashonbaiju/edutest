# InfinityFree & Apache Compatible Configuration

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Optional: Force HTTPS if SSL is configured
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Protect sensitive configuration and database files
<FilesMatch "\.(sql|bak|log|ini|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
